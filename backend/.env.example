# Copy to .env; do not commit credentials. Relative paths use backend's working directory.
RAG_ENABLED=true
RAG_DATA_DIR=./data/rag
# Defaults below derive from RAG_DATA_DIR when omitted.
# RAG_UPLOAD_DIR=./data/rag/uploads
# RAG_INDEX_DIR=./data/rag/index
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_CHUNK_STRATEGY=paragraph
RAG_EMBEDDING_BATCH_SIZE=32
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=12000
RAG_RERANK_ENABLED=false
RAG_RERANK_MODEL=
RAG_MAX_UPLOAD_MB=25
# RAG_SIMILARITY_THRESHOLD=0.3
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
# RAG_SYSTEM_PROMPT=Your complete grounding and citation instructions
# OS-level resource injection (app/os_limits.py); applied per worker at startup.
# OS_THREADS=1
# OS_CPU_AFFINITY=0-1
# OS_NICE=0
# Shed upload/retrieve/query with 503 below this much free cgroup memory (0 disables).
OS_MIN_AVAILABLE_MB=0
# Refuse to load the embedding model with less free memory than this (0 disables).
OS_MODEL_LOAD_MB=0
