      }
    },
    {
      "type": "timeseries",
      "title": "Pressure stall (share of time)",
      "description": "PSI 'some': time at least one task in the scope was stalled.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(chaoslab_cgroup_pressure_stall_seconds_total[30s])",
          "legendFormat": "{{component}} {{resource}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
